# =============================================================================
# Archivage — variables d'environnement globales
# Copier en .env puis éditer si besoin. Aucune valeur sensible n'est committée.
# =============================================================================

# ── Identité ───────────────────────────────
APP_NAME=Archivage
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_URL=http://localhost:8000
FRONT_URL=http://localhost:3000

# ── Locale du backend Laravel (.env backend) ─
BACK_LOG_CHANNEL=stack
BACK_LOG_LEVEL=debug

# ── PostgreSQL (docker-compose Postgres 16) ─
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=archivage
DB_USERNAME=archivage
DB_PASSWORD=archivage

# ── Redis (cache + queue) ───────────────────
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Stockage (disque en v1, S3/MinIO pour la prod) ─
FILESYSTEM_DISK=local
# Pour basculer sur MinIO :
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=archives
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Quota / types ──────────────────────────
ARCHIVE_MAX_UPLOAD_MB=200
ARCHIVE_ALLOWED_MIMES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv

# ── Sanctum ───────────────────────────────
SANCTUM_TOKEN_LIFETIME_MIN=120
SANCTUM_REFRESH_LIFETIME_MIN=43200 # 30 jours

# ── Ports docker exposés sur l'hôte ───────
APP_PORT=8000
APP_WORKER_PORT=9001
POSTGRES_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FRONTEND_PORT=3000

# ── Accès distant (ngrok, profil « remote ») ─
# Jeton : https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domaine fixe (ex. archivage.ngrok.app) ; vide = domaine gratuit du compte
NGROK_URL=
