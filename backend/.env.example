## Cible ce fichier sous backend/.env (jamais versionné). Cf. ../.env.example pour les valeurs transmises à docker.

APP_NAME=Archivage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_URL=http://localhost:8000
FRONT_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=archivage
DB_USERNAME=archivage
DB_PASSWORD=archivage

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Storage disk options (when MinIO is enabled)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=archives
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Archivage quota
ARCHIVE_MAX_UPLOAD_MB=200
ARCHIVE_ALLOWED_MIMES="application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
SANCTUM_TOKEN_LIFETIME_MIN=120
SANCTUM_REFRESH_LIFETIME_MIN=43200
